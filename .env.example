# Port & host web UI
PORT=9843
HOST=0.0.0.0

# Password untuk membuka UI (kosongkan = tanpa password, TIDAK disarankan di server publik)
PASSWORD=ganti-password-ini

# Folder config/database/log dan folder hasil rekaman
DATA_DIR=./data
DOWNLOAD_DIR=./downloads

# Lokasi binary (opsional, default dari PATH)
FFMPEG_PATH=ffmpeg
YTDLP_PATH=yt-dlp

# Zona waktu untuk nama file rekaman
TZ=Asia/Jakarta
